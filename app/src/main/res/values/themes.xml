<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Orbit" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <!-- Swipe-to-dismiss fights horizontal panning; Back is the hardware button and the menu. -->
        <item name="android:windowSwipeToDismiss" tools:ignore="WearBackNavigation">false</item>
        <!-- A dark app theme is what lets WebView apply algorithmic darkening. -->
        <item name="android:isLightTheme">false</item>
    </style>
</resources>
